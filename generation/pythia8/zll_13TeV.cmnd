! --------------- Beams -----------------
! Pythia uses GeV, PP Collisions at 13TeV

Beams:eCM = 13000

! q qbar -> Z/gamma* (Drell-Yan)

WeakSingleBoson:ffbar2gmZ = on

PhaseSpace:mHatMin = 50
PhaseSpace:mHatMax = 150

! ---- Z decays ----
! Switch off all Z decay channels...
23:onMode = off
! ...then switch on only decays to electrons (11) and muons (13)
23:onIfAny = 11 13


! ------------- Write ----------------------
Main:writeHepMC = on

!-------------- Progress -------------------
Next:numberCount = 100
